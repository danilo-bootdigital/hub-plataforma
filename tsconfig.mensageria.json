{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "outDir": ".tmp-mensageria",
    "rootDir": "lib",
    "types": ["node"]
  },
  "include": ["lib/mensageria/**/*.ts"],
  "exclude": ["lib/mensageria/poller/supabase-deps.ts", "lib/mensageria/envio/acao-enviar-texto.ts"]
}
