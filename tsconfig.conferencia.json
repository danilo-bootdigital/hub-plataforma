{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "outDir": ".tmp-conferencia",
    "rootDir": "lib/conferencia",
    "types": ["node"]
  },
  "include": ["lib/conferencia/**/*.ts"]
}
